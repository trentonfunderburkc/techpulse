---
const enabled = import.meta.env.PUBLIC_ENABLE_METRIKA === 'true';
const counterId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '';
const digits = counterId.replace(/\D/g, '');
const parsedId = digits ? Number.parseInt(digits, 10) : NaN;
const validId = Number.isFinite(parsedId) && parsedId > 0 ? String(parsedId) : null;
---

{enabled && validId && (
  <>
    <script is:inline define:vars={{ id: validId }}>
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        (k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

      ym(id, 'init', {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true,
      });
    </script>
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${validId}`}
          style="position:absolute; left:-9999px;"
          alt=""
          width="1"
          height="1"
        />
      </div>
    </noscript>
  </>
)}
