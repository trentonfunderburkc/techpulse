---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { CATEGORIES, getCategory } from '../data/categories';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/news/*.webp', {
  eager: true,
  import: 'default',
});

function coverFor(filename: string): ImageMetadata | undefined {
  return imageModules[`/src/assets/news/${filename}`];
}

const allNews = await getCollection('news');
const sorted = [...allNews].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
const heroCover = featured ? coverFor(featured.data.image) : undefined;

const popular = sorted.filter((p) => p.data.popular).slice(0, 6);
const feed = sorted.filter((p) => !featured || p.slug !== featured.slug).slice(0, 9);

function latestInCategory(slug: string, n: number) {
  return sorted.filter((p) => p.data.category === slug).slice(0, n);
}
---

<Layout
  title="Главная"
  description="TechPulse — новости и аналитика о технологиях: устройства, ИИ, умный дом и инфраструктура. Материалы редакции и приглашённых авторов."
>
  <section class="border-b border-ink-200 bg-gradient-to-b from-white to-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      {
        featured && (
          <a
            href={`/news/${featured.slug}/`}
            data-ym-featured-news
            class="grid gap-8 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm transition hover:border-accent/30 lg:grid-cols-2"
          >
            <div class="aspect-[16/10] bg-ink-100 lg:aspect-auto lg:min-h-[320px]">
              {heroCover ? (
                <Image
                  src={heroCover}
                  alt={featured.data.image_alt ?? featured.data.title}
                  widths={[640, 960, 1200]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="eager"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full min-h-[200px] items-center justify-center text-ink-400">Нет обложки</div>
              )}
            </div>
            <div class="flex flex-col justify-center p-6 sm:p-10">
              <p class="text-xs font-semibold uppercase tracking-wide text-accent">
                {getCategory(featured.data.category)?.title ?? 'Материал'}
              </p>
              <h1 class="mt-2 text-balance text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
                {featured.data.title}
              </h1>
              {featured.data.subtitle && (
                <p class="mt-3 text-lg text-ink-600">{featured.data.subtitle}</p>
              )}
              <p class="mt-4 text-sm text-ink-600">{featured.data.excerpt}</p>
              <div class="mt-6 flex flex-wrap gap-4 text-sm text-ink-500">
                <span>{featured.data.author}</span>
                <time datetime={featured.data.date}>{featured.data.date}</time>
              </div>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-10 lg:flex-row">
      <div class="flex-1">
        <h2 class="text-xl font-bold text-ink-900">Свежая лента</h2>
        <ul id="news-grid" class="mt-6 grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
          {feed.map((post) => <NewsCard post={post} cover={coverFor(post.data.image)} />)}
        </ul>
      </div>
      <aside class="lg:w-80 lg:shrink-0">
        <h2 class="text-lg font-bold text-ink-900">Популярное</h2>
        <ol class="mt-4 space-y-4">
          {
            popular.map((post, i) => (
              <li class="flex gap-3 border-b border-ink-100 pb-4 last:border-0">
                <span class="text-2xl font-bold text-ink-200 tabular-nums">{i + 1}</span>
                <div>
                  <a href={`/news/${post.slug}/`} class="font-medium text-ink-900 hover:text-accent">
                    {post.data.title}
                  </a>
                  <p class="mt-1 text-xs text-ink-500">{post.data.date}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="mt-10 rounded-xl border border-ink-200 bg-ink-50 p-5">
          <h3 class="font-semibold text-ink-900">Рассылка</h3>
          <p class="mt-2 text-sm text-ink-600">
            Готовим дайджест лучших материалов. Оставьте email в
            <a href="/contacts/" class="font-medium text-accent hover:underline">контактах редакции</a>
            — подключим вас вручную после запуска списка рассылки.
          </p>
        </div>
      </aside>
    </div>
  </section>

  {
    CATEGORIES.map((cat) => {
      const items = latestInCategory(cat.slug, 3);
      if (items.length === 0) return null;
      return (
        <section class="border-t border-ink-200 bg-white py-12">
          <div class="mx-auto max-w-6xl px-4 sm:px-6">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <h2 class="text-xl font-bold text-ink-900">{cat.title}</h2>
                <p class="mt-1 max-w-2xl text-sm text-ink-600">{cat.description}</p>
              </div>
              <a href={`/category/${cat.slug}/`} class="text-sm font-semibold text-accent hover:underline">
                Все материалы рубрики
              </a>
            </div>
            <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((post) => (
                <NewsCard post={post} cover={coverFor(post.data.image)} />
              ))}
            </ul>
          </div>
        </section>
      );
    })
  }

  <script>
    import { reachGoal } from '../utils/metrics.js';

    document.querySelector('[data-ym-featured-news]')?.addEventListener('click', () => {
      reachGoal('featured_news_click');
    });
  </script>
</Layout>
