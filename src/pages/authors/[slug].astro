---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((a) => ({
    params: { slug: a.slug },
    props: { author: a },
  }));
}

const { author } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/news/*.webp', {
  eager: true,
  import: 'default',
});

function coverFor(filename: string): ImageMetadata | undefined {
  return imageModules[`/src/assets/news/${filename}`];
}

const all = await getCollection('news');
const posts = all
  .filter((p) => p.data.author_slug === author.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title={author.data.name}
  description={author.data.bio}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav class="text-sm text-ink-500" aria-label="Хлебные крошки">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-accent">Главная</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/authors/" class="hover:text-accent">Авторы</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ink-700">{author.data.name}</li>
      </ol>
    </nav>
    <header class="mt-8 max-w-3xl">
      <h1 class="text-3xl font-bold text-ink-900">{author.data.name}</h1>
      <p class="mt-2 text-ink-500">{author.data.role}</p>
      <p class="mt-4 text-lg text-ink-700">{author.data.bio}</p>
      <p class="mt-4 text-sm text-ink-600">
        Темы: <span class="font-medium">{author.data.topics.join(', ')}</span>
      </p>
      {
        author.data.email && (
          <p class="mt-4 text-sm">
            <a href={`mailto:${author.data.email}`} class="font-medium text-accent hover:underline">
              {author.data.email}
            </a>
          </p>
        )
      }
    </header>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-ink-900">Материалы</h2>
      {
        posts.length === 0 ? (
          <p class="mt-4 text-ink-600">Пока нет опубликованных материалов.</p>
        ) : (
          <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <NewsCard post={post} cover={coverFor(post.data.image)} />
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Layout>
