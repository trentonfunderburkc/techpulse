---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../data/categories';

interface Props {
  post: CollectionEntry<'news'>;
  cover?: ImageMetadata;
}

const { post, cover } = Astro.props;
const cat = getCategory(post.data.category);
const href = `/news/${post.slug}/`;
---

<li>
  <a
    href={href}
    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm transition hover:border-accent/40 hover:shadow-md"
  >
    <div class="aspect-[16/10] overflow-hidden bg-ink-100">
      {
        cover ? (
          <Image
            src={cover}
            alt={post.data.image_alt ?? post.data.title}
            widths={[400, 600, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-sm text-ink-400">Нет обложки</div>
        )
      }
    </div>
    <div class="flex flex-1 flex-col p-5">
      {
        cat && (
          <p class="text-xs font-semibold uppercase tracking-wide text-accent">
            {cat.title}
          </p>
        )
      }
      <h2 class="mt-1 text-lg font-semibold text-ink-900 group-hover:text-accent">
        {post.data.title}
      </h2>
      {post.data.subtitle && <p class="mt-1 text-sm text-ink-500">{post.data.subtitle}</p>}
      <p class="mt-2 line-clamp-3 text-sm text-ink-600">{post.data.excerpt}</p>
      <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-4 text-xs text-ink-500">
        <span>{post.data.author}</span>
        <time datetime={post.data.date}>{post.data.date}</time>
        {post.data.updated_at && <span>обновлено {post.data.updated_at}</span>}
      </div>
    </div>
  </a>
</li>
