# Публичный URL сайта без завершающего слэша (canonical, OG, sitemap, JSON-LD).
# Перед выкладкой на свой домен замените на https://ваш-домен
PUBLIC_SITE_URL=https://techmedia.space

# Включить загрузку счётчика Яндекс.Метрики в продакшене: true
PUBLIC_ENABLE_METRIKA=false
# ID счётчика (только цифры)
PUBLIC_YANDEX_METRIKA_ID=00000000
