---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const all = await getCollection('news');
const sorted = [...all].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const byYear = new Map<string, typeof sorted>();
for (const p of sorted) {
  const y = p.data.date.slice(0, 4);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
---

<Layout
  title="Архив"
  description="Все материалы TechPulse по годам публикации."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-ink-900">Архив</h1>
    <p class="mt-3 text-ink-600">Хронологический список публикаций. Для выборки по темам используйте рубрики в шапке сайта.</p>

    {
      years.map((year) => (
        <section class="mt-12">
          <h2 class="text-xl font-bold text-ink-900">{year}</h2>
          <ul class="mt-4 divide-y divide-ink-100 border-t border-ink-100">
            {byYear.get(year)!.map((p) => (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between">
                <a href={`/news/${p.slug}/`} class="font-medium text-ink-900 hover:text-accent">
                  {p.data.title}
                </a>
                <time class="shrink-0 text-sm text-ink-500" datetime={p.data.date}>
                  {p.data.date}
                </time>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
