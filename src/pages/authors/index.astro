---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const authors = await getCollection('authors');
const sorted = [...authors].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
---

<Layout
  title="Авторы"
  description="Редакция и внештатные авторы TechPulse — темы, опыт и контакты для обратной связи."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-ink-900">Авторы</h1>
    <p class="mt-3 max-w-2xl text-ink-600">
      Материалы подписываются конкретными людьми. Если вы заметили ошибку или хотите предложить тему — напишите автору или на общий ящик
      редакции.
    </p>
    <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((a) => (
          <li class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-ink-900">
              <a href={`/authors/${a.slug}/`} class="hover:text-accent">
                {a.data.name}
              </a>
            </h2>
            <p class="mt-1 text-sm text-ink-500">{a.data.role}</p>
            <p class="mt-3 text-sm text-ink-700">{a.data.bio}</p>
            <p class="mt-3 text-xs text-ink-500">
              Темы: {a.data.topics.join(', ')}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
